{
  "name": "Lead Enrichment and Scoring",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-lead",
        "options": {}
      },
      "id": "5c1f0a4e-2c0a-4f6e-9a1b-7d3c8e0f1a01",
      "name": "Webhook - New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "b7a0e2c4-9f11-4a2d-8f3e-5a6b7c8d9e01"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LEAD_ROUTER_URL }}/leads/ingest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.LEAD_ROUTER_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json.body }}",
        "options": {}
      },
      "id": "5c1f0a4e-2c0a-4f6e-9a1b-7d3c8e0f1a02",
      "name": "HTTP Request - lead-router",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "9d2b6f10-3a44-4c7b-8b0e-1f2a3b4c5d01",
              "leftValue": "={{ $json.score }}",
              "rightValue": 60,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5c1f0a4e-2c0a-4f6e-9a1b-7d3c8e0f1a03",
      "name": "IF - Qualified Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#leads-qualificados",
          "mode": "name"
        },
        "text": "=Novo lead qualificado: {{ $json.lead.name }} ({{ $json.lead.email }}) — score {{ $json.score }}. {{ $json.reasoning }}",
        "otherOptions": {}
      },
      "id": "5c1f0a4e-2c0a-4f6e-9a1b-7d3c8e0f1a04",
      "name": "Slack - Notify Sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1020, 220]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "#leads-descartados",
          "mode": "name"
        },
        "text": "=Lead não qualificado: {{ $json.lead.name }} — score {{ $json.score }}.",
        "otherOptions": {}
      },
      "id": "5c1f0a4e-2c0a-4f6e-9a1b-7d3c8e0f1a05",
      "name": "Slack - Log Discarded",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1020, 380]
    }
  ],
  "connections": {
    "Webhook - New Lead": {
      "main": [[{ "node": "HTTP Request - lead-router", "type": "main", "index": 0 }]]
    },
    "HTTP Request - lead-router": {
      "main": [[{ "node": "IF - Qualified Lead", "type": "main", "index": 0 }]]
    },
    "IF - Qualified Lead": {
      "main": [
        [{ "node": "Slack - Notify Sales", "type": "main", "index": 0 }],
        [{ "node": "Slack - Log Discarded", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
