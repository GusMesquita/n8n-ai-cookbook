{
  "name": "Lead Enrichment and Scoring",
  "nodes": [
    {
      "parameters": {
        "path": "new-lead",
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "id": "1",
      "name": "Webhook - New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/leads/ingest",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "X-API-Key", "value": "={{ $env.LEAD_ROUTER_API_KEY }}" }]
        }
      },
      "id": "2",
      "name": "HTTP Request - lead-router",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.score }}",
              "operation": "largerEqual",
              "value2": 60
            }
          ]
        }
      },
      "id": "3",
      "name": "IF - Qualified Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "channel": "#leads-qualificados",
        "text": "=Novo lead qualificado: {{ $json.lead.name }} ({{ $json.lead.email }}) — score {{ $json.score }}. {{ $json.reasoning }}"
      },
      "id": "4",
      "name": "Slack - Notify Sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1020, 220]
    },
    {
      "parameters": {
        "channel": "#leads-descartados",
        "text": "=Lead não qualificado: {{ $json.lead.name }} — score {{ $json.score }}."
      },
      "id": "5",
      "name": "Slack - Log Discarded",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1020, 380]
    }
  ],
  "connections": {
    "Webhook - New Lead": {
      "main": [[{ "node": "HTTP Request - lead-router", "type": "main", "index": 0 }]]
    },
    "HTTP Request - lead-router": {
      "main": [[{ "node": "IF - Qualified Lead", "type": "main", "index": 0 }]]
    },
    "IF - Qualified Lead": {
      "main": [
        [{ "node": "Slack - Notify Sales", "type": "main", "index": 0 }],
        [{ "node": "Slack - Log Discarded", "type": "main", "index": 0 }]
      ]
    }
  }
}
