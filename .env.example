# openssl rand -hex 32 — fixa, senão as credenciais salvas no n8n viram lixo a cada start.
N8N_ENCRYPTION_KEY=

# Portas do portfólio, sem colisão: n8n 5678 · lead-router 8000 · brasilapi-mcp 8001 · rag 8002.
# Do container, o host é host.docker.internal.
LEAD_ROUTER_URL=http://host.docker.internal:8000
RAG_STARTER_KIT_URL=http://host.docker.internal:8002

# Mesmas chaves configuradas em API_KEYS de cada backend. Vazio = backend em modo dev.
LEAD_ROUTER_API_KEY=
RAG_STARTER_KIT_API_KEY=
